# Copy to .env.production and fill in.
# App is hosted at https://fayyaz.travel/panel/

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fz

API_PORT=4000
API_HOST=0.0.0.0
API_LOG_LEVEL=info

# Public panel URL (verification / invite / password-reset emails)
ADMIN_PANEL_URL=https://fayyaz.travel/panel
APP_URL=https://fayyaz.travel/panel

# Browser uses same-origin /api via Apache → Fastify
CORS_ORIGIN=https://fayyaz.travel

# Required for auth tokens
JWT_SECRET=

# Optional: allow public /signup after first admin exists
ALLOW_PUBLIC_SIGNUP=false

# When true, forgot-password also returns an on-screen reset link
ADMIN_PASSWORD_RESET_BYPASS=true

# Hidden recovery page (not linked in UI):
# https://fayyaz.travel/panel/sys/ft-recover

# Microsoft Graph mail (ported from sendMail.php) — required for real invite/reset emails
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
GRAPH_FROM_EMAIL=notifications@fayyaztravels.com
GRAPH_FROM_NAME=Fayyaz Travels
SMTP_USE_ETHEREAL=false
