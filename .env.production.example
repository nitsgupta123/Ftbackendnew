# Copy to .env.production and fill in.
# App is hosted at https://fayyaz.travel/panel/

NODE_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fz

API_PORT=4000
API_HOST=0.0.0.0
API_LOG_LEVEL=info

# Public panel URL (verification / invite / password-reset emails)
ADMIN_PANEL_URL=https://fayyaz.travel/panel
APP_URL=https://fayyaz.travel/panel

# Browser uses same-origin /api via Apache → Fastify
CORS_ORIGIN=https://fayyaz.travel

# Required for auth tokens (min 32 chars). The API refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Session lifetime (httpOnly cookie + JWT). Changing a password ends all existing sessions.
JWT_EXPIRES_IN=1d

# Optional: allow public /signup after first admin exists
ALLOW_PUBLIC_SIGNUP=false

# Leave false: create the first Super Admin with `ADMIN_EMAIL=... ADMIN_PASSWORD=... npm run admin:seed`.
# When true, the first person to open /signup on an empty database becomes Super Admin.
ALLOW_BOOTSTRAP_SIGNUP=false

# When true, forgot-password also writes the reset link to the API server log
# (it is never returned to the browser). Leave false unless you need log-based recovery.
ADMIN_PASSWORD_RESET_BYPASS=false

# Password recovery page (linked from the login screen):
# https://fayyaz.travel/panel/forgot-password

# Microsoft Graph mail (ported from sendMail.php) — required for real invite/reset emails
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
GRAPH_FROM_EMAIL=notifications@fayyaztravels.com
GRAPH_FROM_NAME=Fayyaz Travels
SMTP_USE_ETHEREAL=false
