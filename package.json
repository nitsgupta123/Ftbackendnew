{
  "name": "ftadmin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-mysql.mjs && concurrently -n api,web -c blue,green \"npm run dev:api\" \"next dev\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "next dev",
    "build": "next build",
    "build:api": "tsc -p server/tsconfig.json --noEmit",
    "start": "next start",
    "start:api": "tsx server/index.ts",
    "lint": "eslint",
    "db:init": "node scripts/init-db.mjs",
    "db:migrate:audit": "node scripts/run-migrate-audit.mjs",
    "db:migrate:admin": "node scripts/run-migrate-admin-users.mjs",
    "db:migrate:categories": "node scripts/run-migrate-categories.mjs",
    "db:migrate:pricing-rules": "node scripts/run-migrate-pricing-rules.mjs",
    "db:migrate:templates": "node scripts/run-migrate-package-templates.mjs",
    "db:migrate:blogs": "node scripts/run-migrate-blogs.mjs",
    "db:migrate:pages": "node scripts/run-migrate-pages.mjs",
    "admin:seed": "node scripts/seed-admin.mjs",
    "test:audit": "node scripts/test-audit-crud.mjs",
    "test:categories": "node scripts/test-categories-crud.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.1.0",
    "@hookform/resolvers": "^5.4.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "lucide-react": "^1.20.0",
    "mysql2": "^3.22.5",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.79.0",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yup": "^1.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.0",
    "@babel/traverse": "^8.0.0",
    "@babel/types": "^8.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
